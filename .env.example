# ============================================
# Silent Link v1-prod — Environment
# Copy to .env and fill in. Never commit .env.
# ============================================

# --- App ---
DEBUG=False

# --- Paths (relative to repo root) ---
GLOSSES_PATH=model/configs/glosses.json
DATA_PATH=data/processed
LOG_DIR=Logs
MODEL_REGISTRY_DIR=model/registry

# --- Model / Inference ---
MODEL_FORMAT=onnx            # onnx | tflite
SEQUENCE_LENGTH=40
PREDICTION_THRESHOLD=0.6
MAX_SENTENCE_LENGTH=5

# --- Camera ---
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480

# --- MediaPipe Hand Landmarker (on-device) ---
MIN_DETECTION_CONFIDENCE=0.5
MIN_TRACKING_CONFIDENCE=0.5

# --- Training (cloud) ---
TEST_SPLIT=0.10
VAL_SPLIT=0.10
EPOCHS=200
BATCH_SIZE=32
EARLY_STOPPING_PATIENCE=15
LEARNING_RATE=1e-3
