# ============================================
# Silent Link v1-prod — Environment
# Copy to .env and fill in. Never commit .env.
# Loaded by backend/silentlink/deps.py.
# ============================================

# --- Backend security ---
# REQUIRED. HMAC key used to sign and verify bearer tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# If left empty the backend generates one at startup, caches it in the
# gitignored backend/.silentlink_secret and logs a warning. That keeps tokens
# valid across restarts and across `uvicorn --workers N` (a per-process key
# would make workers reject each other's tokens), but the key is not yours —
# set it explicitly for anything you care about.
SILENTLINK_SECRET=

# --- App (Expo) ---
# Read at bundle time by app/src/config/api.ts. 10.0.2.2 is the host loopback
# as seen from the Android emulator; use your LAN IP for a physical device.
# EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2:8000

# Training hyperparameters are CLI flags on scripts/train_model.py
# (--epochs / --batch-size / --lr / --val-frac / --patience), not env vars.
